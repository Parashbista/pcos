# Environment Configuration Example
# Copy this file to .env and update with your actual values

# API Base URL for Development
# For emulator/simulator: http://localhost:3000
# For physical device: http://YOUR_LOCAL_IP:3000 (e.g., http://192.168.1.100:3000)
API_BASE_URL_DEV=http://localhost:3000

# API Base URL for Production
# Update this with your production API URL when deploying
API_BASE_URL_PROD=https://your-production-api.com
